/* ==========================================================================
   qgis2ge (QGIS to Google Earth) - Unified Modern Stylesheet
   Designed to seamlessly adapt to QGIS Light & Dark Themes
   ========================================================================== */

/* Main Window */
QDialog#Qgis2GeDialog, QDialog#KmlColorExportDialog {
    background-color: palette(window);
}

/* Scroll Area */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Custom Slim Modern Scrollbar */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 7px;
    margin: 4px 1px 4px 1px;
}

QScrollBar::handle:vertical {
    background: palette(midlight);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: palette(mid);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Header Area */
QFrame#headerFrame {
    background: transparent;
    border-bottom: 1px solid palette(midlight);
    padding-bottom: 8px;
    margin-bottom: 4px;
}

QLabel#headerTitle {
    font-size: 13pt;
    font-weight: bold;
    color: palette(window-text);
}

QLabel#headerSubtitle {
    font-size: 8.5pt;
    color: palette(mid);
    line-height: 1.3;
}

/* Version Pill Badge */
QLabel#badgeVersion {
    background-color: palette(alternate-base);
    color: palette(window-text);
    font-size: 8pt;
    font-weight: 600;
    border: 1px solid palette(midlight);
    border-radius: 10px;
    padding: 2px 8px;
}

/* Card Frames */
QFrame.CardFrame, QFrame[class="CardFrame"] {
    background-color: palette(window);
    border: 1px solid palette(midlight);
    border-radius: 8px;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* Card Header Titles */
QLabel.CardTitle, QLabel[class="CardTitle"] {
    font-weight: 600;
    font-size: 9.5pt;
    color: palette(window-text);
    padding: 0px;
}

/* Grid & Form Labels */
QLabel.FormLabel, QLabel[class="FormLabel"] {
    font-size: 9pt;
    color: palette(window-text);
}

/* Inputs & Form Controls */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
    font-size: 9pt;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: palette(mid);
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1.5px solid palette(highlight);
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: palette(window);
    color: palette(mid);
    border-color: palette(midlight);
}

/* Combobox drop-down styling */
QComboBox {
    padding-right: 20px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    margin-right: 4px;
}

QComboBox QAbstractItemView {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

/* Checkboxes and Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 7px;
    font-size: 9pt;
    color: palette(window-text);
}

QCheckBox:hover, QRadioButton:hover {
    color: palette(highlight);
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
}

/* Buttons */
QPushButton {
    font-size: 9pt;
    font-weight: 500;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 20px;
}

QPushButton#exportButton {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    font-weight: 600;
    font-size: 9.5pt;
    border: none;
    padding: 7px 22px;
    min-height: 22px;
}

QPushButton#exportButton:hover {
    opacity: 0.92;
}

QPushButton#exportButton:pressed {
    opacity: 0.85;
}

QPushButton#exportButton:disabled {
    background-color: palette(midlight);
    color: palette(mid);
}

QPushButton#closeButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(midlight);
    padding: 6px 16px;
}

QPushButton#closeButton:hover {
    background-color: palette(midlight);
}

QPushButton#cancelButton {
    background-color: #D32F2F;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 8.5pt;
    border: none;
    border-radius: 5px;
    padding: 4px 12px;
}

QPushButton#cancelButton:hover {
    background-color: #B71C1C;
}

/* Small Action / Filter Buttons */
QPushButton.SmallActionBtn, QPushButton[class="SmallActionBtn"] {
    background-color: palette(alternate-base);
    color: palette(window-text);
    border: 1px solid palette(midlight);
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 8.5pt;
}

QPushButton.SmallActionBtn:hover, QPushButton[class="SmallActionBtn"]:hover {
    background-color: palette(midlight);
}

/* Update Pill Button */
QPushButton#btnCheckUpdate {
    background-color: transparent;
    color: palette(highlight);
    border: 1px solid palette(highlight);
    border-radius: 10px;
    font-size: 8pt;
    font-weight: 600;
    padding: 2px 10px;
}

QPushButton#btnCheckUpdate:hover {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QPushButton#btnUpdateNow {
    background-color: #2E7D32;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 8.5pt;
    border: none;
    border-radius: 5px;
    padding: 4px 12px;
}

QPushButton#btnUpdateNow:hover {
    background-color: #1B5E20;
}

/* Collapsible Section Toggle Button */
QPushButton#toggleAdvancedBtn {
    text-align: left;
    font-weight: 600;
    font-size: 9.5pt;
    border: none;
    background: transparent;
    color: palette(window-text);
    padding: 3px 0px;
}

QPushButton#toggleAdvancedBtn:hover {
    color: palette(highlight);
}

/* Sliders */
QSlider::groove:horizontal {
    height: 5px;
    background: palette(midlight);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: palette(highlight);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: palette(button);
    border: 1.5px solid palette(highlight);
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: palette(highlight);
}

/* List Widget */
QListWidget {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    padding: 4px;
    font-size: 9pt;
}

QListWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: palette(alternate-base);
}

QListWidget::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

/* Progress Bar */
QProgressBar {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(midlight);
    border-radius: 6px;
    text-align: center;
    font-size: 8.5pt;
    font-weight: 600;
    height: 18px;
}

QProgressBar::chunk {
    background-color: palette(highlight);
    border-radius: 5px;
}

/* Error Label */
QLabel#errorLabel {
    color: #D32F2F;
    font-size: 8.5pt;
    padding-top: 2px;
}

/* Footer Container */
QFrame#footerFrame {
    border-top: 1px solid palette(midlight);
    padding-top: 10px;
    margin-top: 4px;
}

/* Color Swatches Container - Clean & Borderless */
QScrollArea#swatchesScrollArea {
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
}

QScrollArea#swatchesScrollArea > QWidget > QWidget {
    background: transparent;
}

